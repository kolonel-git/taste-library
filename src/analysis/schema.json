{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TasteAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "styleGuide", "palette", "keywords", "tags"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "description": "Short, evocative name for the piece. Not a filename."
    },
    "description": {
      "type": "string",
      "minLength": 80,
      "description": "Detailed prose description of everything the image contains."
    },
    "styleGuide": {
      "type": "string",
      "minLength": 200,
      "description": "Markdown style guide with the sections Colour, Typography, Layout & grid, Spacing, Components & patterns, Iconography, Imagery, Texture & depth, Mood."
    },
    "palette": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hex", "role"],
        "properties": {
          "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "role": {
            "type": "string",
            "enum": ["primary", "secondary", "accent", "background", "surface", "text", "muted", "border"]
          },
          "name": { "type": "string" }
        }
      }
    },
    "keywords": {
      "type": "array",
      "minItems": 5,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 2 },
      "description": "Reusable style and theme terms for briefing other design work."
    },
    "tags": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "description": "Short kebab-case labels. Reuse existing tags where they fit."
    }
  }
}
